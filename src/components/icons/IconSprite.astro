---
/**
 * The theme's icon set, rendered once per page as an inline SVG sprite.
 *
 * Every icon is drawn on a 24×24 viewBox (except `logo`, which uses 32×32)
 * and inherits `currentColor`, so the same symbol works on light and dark
 * surfaces. Reference them with the `<Icon />` component:
 *
 *     <Icon name="arrow" class="ic-sm" />
 *
 * To add an icon, drop a `<g id="i-yourname">` in here and add the name to
 * `IconName` in `src/types.ts`.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="i-arrow" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7"></path><path d="M8.6 7H17v8.4"></path></g>
    <g id="i-dribbble" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M4.3 8.4c5.5.1 10.4-1.3 13.5-4"></path><path d="M20.6 9.9C15.2 9.2 9 12.2 6 18.6"></path><path d="M8.7 3.7C13 7.5 15.8 13 16.6 20.2"></path></g>
    <g id="i-behance" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7.2h4.4a2.3 2.3 0 0 1 0 4.5H3z"></path><path d="M3 11.7h5a2.5 2.5 0 0 1 0 5H3z"></path><path d="M14.2 13.3h6.4c0-2-1.4-3.5-3.2-3.5s-3.2 1.5-3.2 3.5 1.4 3.5 3.2 3.5c1.3 0 2.3-.5 2.8-1.5"></path><path d="M15.3 6.9h4.4"></path></g>
    <g id="i-linkedin" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5.6 9.8v8.6"></path><circle cx="5.6" cy="5.9" r="1.1" fill="currentColor" stroke="none"></circle><path d="M10.6 18.4V9.8"></path><path d="M10.6 13.6c0-2.2 1.4-3.9 3.4-3.9s3.4 1.7 3.4 3.9v4.8"></path></g>
    <g id="i-facebook" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14.6 21v-8.2h2.7l.5-3.2h-3.2V7.4c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.8-.1-1.6-.15-2.4-.15-2.4 0-4 1.45-4 4.1v2.55H8.7v3.2h3.8V21"></path></g>
    <g id="i-instagram" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"></circle></g>
    <g id="i-phone" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8.2 4.3 9.9 8 8.2 9.9c.9 2 2.4 3.6 4.5 4.5l1.9-1.7 3.7 1.7v3.2c0 1.1-.9 1.9-2 1.8C9.9 19 5 14.1 4.4 7.7c-.1-1.1.7-2 1.8-2h2z"></path></g>
    <g id="i-mail" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3.2" y="5.4" width="17.6" height="13.2" rx="2.6"></rect><path d="m3.9 7.3 7.1 5c.6.4 1.4.4 2 0l7.1-5"></path></g>
    <g id="i-pin" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c4-4.3 6.2-7.5 6.2-10.3A6.2 6.2 0 0 0 5.8 10.7C5.8 13.5 8 16.7 12 21z"></path><circle cx="12" cy="10.5" r="2.4"></circle></g>
    <g id="i-plus" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M12 7v10M7 12h10"></path></g>
    <path id="i-star" d="M12 3.2l2.6 5.6 6 .8-4.4 4.2 1.1 6.1-5.3-3-5.3 3 1.1-6.1L3.4 9.6l6-.8z" fill="currentColor"></path>
    <path id="i-quote" d="M9.6 5.9C6.2 7.4 4.3 10.3 4.3 14v4.1h6.6v-6.3H7.6c.2-1.8 1.2-3.1 2.9-4zM20.1 5.9c-3.4 1.5-5.3 4.4-5.3 8.1v4.1h6.6v-6.3h-3.3c.2-1.8 1.2-3.1 2.9-4z" fill="currentColor"></path>
    <g id="i-check" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5.5 12.4 9.7 16.6 18.5 7.8"></path></g>
    <path id="i-play" d="M8.4 5.8 18.6 12 8.4 18.2z" fill="currentColor"></path>
    <g id="i-menu" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M4 7.5h16M4 12h16M4 16.5h16"></path></g>
    <g id="i-close" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></g>
    <g id="i-up" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V6"></path><path d="M6.4 11.4 12 5.8l5.6 5.6"></path></g>

    <!-- Service / toolkit icons -->
    <g id="i-grid" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3.4" y="3.4" width="7.2" height="7.2" rx="2"></rect><rect x="13.4" y="3.4" width="7.2" height="7.2" rx="2"></rect><rect x="3.4" y="13.4" width="7.2" height="7.2" rx="2"></rect><rect x="13.4" y="13.4" width="7.2" height="7.2" rx="2"></rect></g>
    <g id="i-code" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m8.4 8.6-4 3.4 4 3.4"></path><path d="m15.6 8.6 4 3.4-4 3.4"></path><path d="m13.4 5.4-2.8 13.2"></path></g>
    <g id="i-pen" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 19.5h3.4L19 8.4a2.4 2.4 0 0 0-3.4-3.4L4.5 16.1z"></path><path d="m14.6 6 3.4 3.4"></path></g>
    <g id="i-spark" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.4 13.9 9l5.6 1.9-5.6 1.9L12 18.4 10.1 12.8 4.5 10.9 10.1 9z"></path><path d="M18.6 16.4 19.4 18.6 21.6 19.4 19.4 20.2 18.6 22.4 17.8 20.2 15.6 19.4 17.8 18.6z"></path></g>
    <g id="i-layers" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3.6 8.4 4.3L12 12.2 3.6 7.9z"></path><path d="m3.6 12.3 8.4 4.3 8.4-4.3"></path><path d="m3.6 16.4 8.4 4.3 8.4-4.3"></path></g>
    <g id="i-chart" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V4"></path><path d="M4 20h16"></path><path d="M8.4 16.4V11"></path><path d="M13 16.4V7.4"></path><path d="M17.6 16.4v-3.6"></path></g>
    <g id="i-device" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3.2" y="4.4" width="13" height="10.4" rx="2"></rect><rect x="16.6" y="9.4" width="4.4" height="10.2" rx="1.6"></rect><path d="M3.2 18.4h9.4" stroke-linecap="round"></path></g>
    <g id="i-type" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 6.4V4.6h14v1.8"></path><path d="M12 4.6v14.8"></path><path d="M9 19.4h6"></path></g>
    <g id="i-motion" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"></circle><path d="M12 6.8V12l3.4 2"></path></g>
    <g id="i-flag" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5.4 21V4.2"></path><path d="M5.4 5h11.2l-2.2 3.6 2.2 3.6H5.4"></path></g>

    <!-- Monogram -->
    <g id="i-logo"><circle cx="16" cy="16" r="15" fill="currentColor"></circle><path d="M16 6.6c2.4 3.5 3.4 5.6 3.4 9.4s-1 5.9-3.4 9.4c-2.4-3.5-3.4-5.6-3.4-9.4s1-5.9 3.4-9.4z" fill="#C8F14D"></path><circle cx="16" cy="16" r="2.6" fill="#101110"></circle></g>
    <g id="i-asterisk" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3.5v17M4.6 7.8l14.8 8.4M19.4 7.8 4.6 16.2"></path></g>
  </defs>
</svg>
