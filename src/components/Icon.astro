---
import type { IconName } from '~/types';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'svg'>, 'viewBox'> {
  /** Icon id, without the `i-` prefix. */
  name: IconName;
  /** Accessible label. Omit it and the icon is hidden from assistive tech. */
  label?: string;
}

const { name, label, class: className = 'ic', ...rest } = Astro.props;
const viewBox = name === 'logo' ? '0 0 32 32' : '0 0 24 24';
---

<svg
  class={className}
  viewBox={viewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...rest}
>
  <use href={`#i-${name}`}></use>
</svg>
