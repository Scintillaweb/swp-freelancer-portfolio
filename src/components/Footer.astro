---
import Icon from './Icon.astro';
import siteConfig from '~/config/site';
import { footerNav } from '~/data/navigation';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

const services = (await getCollection('services'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);

const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr-top">
    <div>
      <a class="ftr-brand" href="/">
        <Icon name="logo" class="brand-mark" style="color:#fff" />
        <span>{siteConfig.name}</span>
      </a>
      <p class="ftr-about">{siteConfig.about}</p>
      <div class="ftr-soc">
        {
          siteConfig.social.map((s) => (
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <Icon name={s.icon} class="ic-sm" />
            </a>
          ))
        }
      </div>
    </div>

    <nav aria-labelledby="ftr-explore">
      <h2 id="ftr-explore">Explore</h2>
      <ul class="ftr-links">
        {footerNav.explore.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="ftr-services">
      <h2 id="ftr-services">Services</h2>
      <ul class="ftr-links">
        {services.map((s) => <li><a href={`/services/${s.id}/`}>{s.data.title}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Get in touch</h2>
      <div class="ftr-cbox">
        <Icon name="mail" class="ic-sm" />
        <span><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="phone" class="ic-sm" />
        <span><a href={`tel:${siteConfig.contact.phoneHref}`}>{siteConfig.contact.phone}</a></span>
      </div>
      <div class="ftr-cbox">
        <Icon name="pin" class="ic-sm" />
        <span>{siteConfig.contact.location}</span>
      </div>
    </div>
  </div>

  <div class="wrap ftr-bot">
    <p>&copy; {year} {siteConfig.copyrightHolder}. Built with SWP Freelancer Portfolio, an Astro theme.</p>
    <nav aria-label="Legal">
      {footerNav.legal.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
