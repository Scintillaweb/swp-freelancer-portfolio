---
import Icon from '../Icon.astro';
import type { Testimonial } from '~/types';

interface Props {
  testimonial: Testimonial;
  class?: string;
}

const { testimonial, class: className } = Astro.props;
const { quote, name, role, avatar, avatarAlt, rating } = testimonial;
---

<article class:list={['tst-card', className]}>
  <div class="tst-top">
    <div class="stars" role="img" aria-label={`Rated ${rating} out of 5`}>
      {Array.from({ length: rating }).map(() => <Icon name="star" class="ic-sm" />)}
    </div>
    <Icon name="quote" class="ic-lg muted" style="opacity:.28" />
  </div>
  <blockquote>{quote}</blockquote>
  <div class="tst-who">
    <img src={avatar} alt={avatarAlt} width="88" height="88" loading="lazy" decoding="async" />
    <div>
      <b>{name}</b>
      <span>{role}</span>
    </div>
  </div>
</article>
