---
import Icon from '../Icon.astro';
import { formatDate, isoDate } from '~/lib/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  eager?: boolean;
  class?: string;
  /** Use `h2` on listing pages that have their own `h1`. */
  headingLevel?: 'h2' | 'h3';
}

const { post, eager = false, class: className, headingLevel: Heading = 'h3' } = Astro.props;
const { title, description, category, readingTime, pubDate, image } = post.data;
const href = `/journal/${post.id}/`;
---

<article class:list={['post', className]}>
  <a class="post-media" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={image.src}
      alt=""
      width={image.width}
      height={image.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="post-meta">
    <em>{category}</em>
    <span>{readingTime}</span>
    <span aria-hidden="true">&middot;</span>
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
  </div>
  <Heading><a href={href}>{title}</a></Heading>
  <p>{description}</p>
  <a class="post-link" href={href} tabindex="-1" aria-hidden="true">
    Read article <Icon name="arrow" class="ic-sm" />
  </a>
</article>
