---
import Icon from '../Icon.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
  class?: string;
  headingLevel?: 'h2' | 'h3';
}

const { service, class: className, headingLevel: Heading = 'h3' } = Astro.props;
const { title, icon, number, excerpt, tags } = service.data;
---

<article class:list={['svc-card', className]}>
  <div class="svc-top">
    <span class="svc-ic"><Icon name={icon} class="ic-lg" /></span>
    <span class="svc-num">{number}</span>
  </div>
  <Heading><a class="stretch" href={`/services/${service.id}/`}>{title}</a></Heading>
  <p class="muted">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="svc-tags">
        {tags.map((tag) => <span>{tag}</span>)}
      </div>
    )
  }
</article>
