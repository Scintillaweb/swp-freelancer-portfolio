---
import siteConfig from '~/config/site';
import { absoluteUrl, canonicalUrl } from '~/lib/utils';

interface Props {
  /** Page title. The site name is appended unless `titleTemplate` is false. */
  title: string;
  description?: string;
  /** Override the auto-derived canonical URL. */
  canonical?: string;
  /** Site-relative or absolute Open Graph image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  /** Set false on the homepage, where the title already reads well alone. */
  appendSiteName?: boolean;
  /** Pre-serialised JSON-LD, produced by the helpers in `src/lib/jsonld.ts`. */
  jsonLd?: string;
}

const {
  title,
  description = siteConfig.description,
  canonical,
  image = siteConfig.ogImage,
  imageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  appendSiteName = true,
  jsonLd,
} = Astro.props;

const fullTitle = appendSiteName ? `${title} — ${siteConfig.name}` : title;
const href = canonical ?? canonicalUrl(Astro.url, Astro.site);
const ogImage = image.startsWith('http') ? image : absoluteUrl(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={href} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={imageAlt ?? `${siteConfig.name} — ${siteConfig.role}`} />
<meta property="og:locale" content={siteConfig.locale.replace('-', '_')} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt ?? `${siteConfig.name} — ${siteConfig.role}`} />

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
