---
import Button from './Button.astro';
import siteConfig from '~/config/site';

const endpoint = siteConfig.contact.formEndpoint.trim();
const connected = endpoint.length > 0;
---

<form
  class="form"
  method="post"
  action={connected ? endpoint : undefined}
  name="contact"
  novalidate={false}
>
  <!-- Netlify Forms picks the form up from this attribute at build time. -->
  <input type="hidden" name="form-name" value="contact" />

  <div class="form-row">
    <div class="field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Robin Vale" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="you@company.com" />
    </div>
  </div>

  <div class="field">
    <label for="cf-company">Company <span class="hint">(optional)</span></label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" />
  </div>

  <div class="field">
    <label for="cf-type">What is this about?</label>
    <select id="cf-type" name="project_type">
      <option value="art-direction">Art direction</option>
      <option value="interface-design" selected>Interface design</option>
      <option value="design-systems">Design systems</option>
      <option value="identity">Identity</option>
      <option value="site-build">Site build</option>
      <option value="second-opinion">Second opinion</option>
      <option value="something-else">Something else</option>
    </select>
  </div>

  <div class="field">
    <label for="cf-message">The brief</label>
    <p class="hint" id="cf-message-hint">
      What is broken, who it is breaking for, and what happens if it stays that way.
    </p>
    <textarea
      id="cf-message"
      name="message"
      rows="7"
      required
      aria-describedby="cf-message-hint"
      placeholder="A paragraph is plenty to start with."></textarea>
  </div>

  <!-- Honeypot: hidden from people, irresistible to bots. -->
  <div class="hp" aria-hidden="true">
    <label for="cf-website">Leave this field empty</label>
    <input id="cf-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {
    !connected && (
      <p class="form-note">
        <strong>This form is not connected yet.</strong> Add your form provider's endpoint
        to <code>contact.formEndpoint</code> in <code>src/config/site.ts</code> and it will
        start posting. See <em>Contact form</em> in the README for Formspree, Netlify Forms
        and Web3Forms setups.
      </p>
    )
  }

  <div>
    <Button type="submit" variant="ink" icon="mail" disabled={!connected}>Send the brief</Button>
  </div>
</form>
