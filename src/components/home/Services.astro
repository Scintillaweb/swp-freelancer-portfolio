---
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';
import ServiceCard from '../cards/ServiceCard.astro';
import { servicesHeading } from '~/data/highlights';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';

const services = (await getCollection('services'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);
---

<section class="wrap sec sec-top" id="services" aria-labelledby="svc-h">
  <SectionHeading class="rev" eyebrow={servicesHeading.eyebrow} title={servicesHeading.title} id="svc-h">
    <Button href={servicesHeading.ctaHref} variant="outline">{servicesHeading.ctaLabel}</Button>
  </SectionHeading>

  <div class="svc">
    {
      services.map((service, i) => (
        <ServiceCard service={service} class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]} />
      ))
    }
  </div>
</section>
