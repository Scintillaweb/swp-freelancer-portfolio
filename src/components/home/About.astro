---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import Signature from '../art/Signature.astro';
import siteConfig from '~/config/site';
import { about } from '~/data/highlights';

interface Props {
  /** `h1` when the About page renders this as its main heading. */
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { headingLevel: Heading = 'h2', id = 'about' } = Astro.props;
---

<section class="wrap sec" id={id} aria-labelledby="about-h">
  <div class="about-grid">
    <div class="about-media rev">
      <div class="about-img">
        <img
          src={about.images.main.src}
          alt={about.images.main.alt}
          width={about.images.main.width}
          height={about.images.main.height}
          loading="lazy"
          decoding="async"
        />
        <div class="about-badge">
          <b>{about.badge.value}</b>
          <span>{about.badge.label}</span>
        </div>
        <div class="about-img-inset">
          <img
            src={about.images.inset.src}
            alt={about.images.inset.alt}
            width={about.images.inset.width}
            height={about.images.inset.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <div class="rev rev-d1">
      <p class="eyebrow">{about.eyebrow}</p>
      <Heading class="d2 about-h" id="about-h">{about.title}</Heading>
      <p class="lead">{about.body}</p>

      <ul class="about-list">
        {
          about.points.map((point) => (
            <li>
              <i><Icon name="check" class="ic-xs" /></i>
              <span>{point}</span>
            </li>
          ))
        }
      </ul>

      <div class="about-sign">
        <Signature label={`Signature of ${siteConfig.author}`} />
        <Button href={about.ctaHref} variant="outline">{about.ctaLabel}</Button>
      </div>
    </div>
  </div>
</section>
