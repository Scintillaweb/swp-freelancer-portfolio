---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { faq, faqHeading } from '~/data/faq';

interface Props {
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { headingLevel: Heading = 'h2', id = 'faq' } = Astro.props;
---

<section class="wrap sec sec-top" id={id} aria-labelledby="faq-h">
  <div class="faq-grid">
    <div class="rev">
      <p class="eyebrow">{faqHeading.eyebrow}</p>
      <Heading class="d2 about-h" id="faq-h">{faqHeading.title}</Heading>

      <div class="faq-aside">
        <h2>{faqHeading.asideTitle}</h2>
        <p>{faqHeading.asideBody}</p>
        <Button href={`mailto:${siteConfig.contact.email}`} variant="ink" icon="mail">Write to me</Button>
      </div>
    </div>

    <div class="faq-list rev rev-d1" id="faqList">
      {
        faq.map((item, i) => (
          <details class="faq-item" name="swp-faq" open={i === 0}>
            <summary class="faq-q">
              {item.question}
              <i><Icon name="plus" class="ic-sm" /></i>
            </summary>
            <div class="faq-a"><p>{item.answer}</p></div>
          </details>
        ))
      }
    </div>
  </div>
</section>
