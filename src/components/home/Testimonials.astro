---
import Button from '../Button.astro';
import SectionHeading from '../SectionHeading.astro';
import TestimonialCard from '../cards/TestimonialCard.astro';
import { testimonials, testimonialsHeading } from '~/data/testimonials';
---

<section class="tst" id="testimonials" aria-labelledby="tst-h">
  <div class="wrap sec">
    <SectionHeading
      class="rev"
      eyebrow={testimonialsHeading.eyebrow}
      title={testimonialsHeading.title}
      id="tst-h"
    >
      <Button href="/work/" variant="outline">Read the full cases</Button>
    </SectionHeading>

    <div class="tst-grid">
      {
        testimonials.map((testimonial, i) => (
          <TestimonialCard
            testimonial={testimonial}
            class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
          />
        ))
      }
    </div>
  </div>
</section>
