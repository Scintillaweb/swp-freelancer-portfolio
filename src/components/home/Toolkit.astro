---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { toolkit, toolkitHeading } from '~/data/toolkit';
---

<section class="kit" id="toolkit" aria-labelledby="kit-h">
  <div class="wrap sec">
    <SectionHeading
      class="rev"
      eyebrow={toolkitHeading.eyebrow}
      title={toolkitHeading.title}
      intro={toolkitHeading.intro}
      id="kit-h"
    />
    <div class="kit-grid">
      {
        toolkit.map((item, i) => (
          <div class:list={['kit-item', 'rev', i % 4 > 0 && `rev-d${i % 4}`]}>
            <Icon name={item.icon} class="ic-lg" />
            <b>{item.title}</b>
            <span>{item.detail}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
