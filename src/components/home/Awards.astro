---
import SectionHeading from '../SectionHeading.astro';
import { awards, awardsHeading } from '~/data/awards';
---

<section class="recognition" id="recognition" aria-labelledby="rec-h">
  <div class="wrap sec">
    <SectionHeading class="rev" eyebrow={awardsHeading.eyebrow} title={awardsHeading.title} id="rec-h" />
    <div class="awards">
      {
        awards.map((award) => (
          <article class="award rev">
            <span class="award-yr">{award.year}</span>
            <h3>{award.title}</h3>
            <p>{award.detail}</p>
            <span class="pill pill-lime">{award.tag}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>
