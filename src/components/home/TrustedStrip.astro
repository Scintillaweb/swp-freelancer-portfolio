---
import { clients, clientsLabel } from '~/data/clients';
---

<section class="wrap trust" aria-label="Selected clients">
  <div class="trust-in">
    <p class="trust-lbl">{clientsLabel}</p>
    <div class="marquee">
      <div class="marquee-track" id="mtrack">
        {
          clients.map((client) => (
            <span class="plogo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={client.shape} />
              {client.name}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  /* The track is duplicated so the -50% translate loops seamlessly.
     Doing it here keeps the markup free of duplicated content. */
  const track = document.getElementById('mtrack');
  if (track && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const clone = track.cloneNode(true) as HTMLElement;
    clone.removeAttribute('id');
    clone.setAttribute('aria-hidden', 'true');
    while (clone.firstChild) track.appendChild(clone.firstChild);
  }
</script>
