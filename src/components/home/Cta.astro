---
import Icon from '../Icon.astro';
import Button from '../Button.astro';
import siteConfig from '~/config/site';
import { cta } from '~/data/highlights';

interface Props {
  id?: string;
}

const { id = 'cta' } = Astro.props;
---

<section class="wrap sec-tight" id={id} aria-labelledby="cta-h">
  <div class="cta rev">
    <span class="cta-ring a" aria-hidden="true"></span>
    <span class="cta-ring b" aria-hidden="true"></span>

    <p class="eyebrow">{siteConfig.contact.availability}</p>
    <h2 class="d2" id="cta-h">{cta.title}</h2>
    <p>{cta.body}</p>

    <div class="cta-actions">
      <Button href="/contact/" variant="ink">{cta.primaryLabel}</Button>
      <a class="btn btn-outline-ink" href={`tel:${siteConfig.contact.phoneHref}`}>
        <span>{siteConfig.contact.phone}</span>
        <i><Icon name="phone" class="ic-sm" /></i>
      </a>
    </div>
  </div>
</section>
