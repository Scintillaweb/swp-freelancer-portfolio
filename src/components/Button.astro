---
import Icon from './Icon.astro';
import type { IconName } from '~/types';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'lime' | 'ink' | 'outline' | 'outline-ink' | 'ghost-light';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  /** Renders an `<a>` when set, a `<button>` otherwise. */
  href?: string;
  variant?: Variant;
  /** Icon shown in the round badge. */
  icon?: IconName;
  /** Button type, used only when `href` is omitted. */
  type?: 'button' | 'submit' | 'reset';
  /** Disables the button. Ignored when `href` is set. */
  disabled?: boolean;
}

const {
  href,
  variant = 'lime',
  icon = 'arrow',
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const classes = ['btn', `btn-${variant}`, className].filter(Boolean).join(' ');
const external = href?.startsWith('http');
---

{
  href ? (
    <a
      href={href}
      class={classes}
      rel={external ? 'noopener noreferrer' : undefined}
      target={external ? '_blank' : undefined}
      {...rest}
    >
      <span><slot /></span>
      <i><Icon name={icon} class="ic-sm" /></i>
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <span><slot /></span>
      <i><Icon name={icon} class="ic-sm" /></i>
    </button>
  )
}
