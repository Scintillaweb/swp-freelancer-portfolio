  <path d="M62 26c6-2 10-5 10-8s-3-3-5 0-4 9-3 14 4 8 8 8 8-4 11-10"></path>
  <path d="M96 41c1-11 3-17 6-17s3 4 3 8"></path>
  <path d="M108 32c3-8 6-12 9-12s3 4 2 9-3 10-1 11 6-4 10-13"></path>
  <path d="M120 46c9-3 17-8 23-15"></path>
</svg>
