---
/** Hand-drawn signature mark. Replace the paths with your own if you like. */
interface Props { label?: string; class?: string }
const { label = 'Handwritten signature', class: className = 'sign-svg' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 150 52"
  fill="none"
  stroke="currentColor"
  stroke-width="2.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={label}
>
