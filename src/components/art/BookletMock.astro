---
/**
 * Folded brand booklet mockup. Custom artwork drawn for this theme —
 * scales to any size and needs no raster asset.
 */
interface Props { label?: string }
const { label = 'Folded brand booklet mockup on a neutral surface' } = Astro.props;
// Gradient ids must be unique if the artwork is used more than once per page.
const u = Math.random().toString(36).slice(2, 8);
---

<svg viewBox="0 0 400 500" role="img" aria-label={label}>
  <defs>
    <linearGradient id={`bkA-${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#EDEBE7"></stop><stop offset="1" stop-color="#D9D6D0"></stop></linearGradient>
    <linearGradient id={`bkB-${u}`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FFFFFF"></stop><stop offset="1" stop-color="#E7E5E0"></stop></linearGradient>
    <linearGradient id={`bkC-${u}`} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#F6F5F2"></stop><stop offset="1" stop-color="#CFCCC5"></stop></linearGradient>
  </defs>
  <rect width="400" height="500" fill={`url(#bkA-${u})`}></rect>
  <ellipse cx="205" cy="392" rx="150" ry="26" fill="#000" opacity=".14"></ellipse>
  <path d="M92 388V168l108-34v220z" fill={`url(#bkB-${u})`}></path>
  <path d="M200 354V134l112 36v218z" fill={`url(#bkC-${u})`}></path>
  <path d="M200 134v220" stroke="#C6C2BA" stroke-width="1.6"></path>
  <g transform="rotate(-14 150 250)" fill="#101110">
    <rect x="108" y="212" width="72" height="7" rx="3.5"></rect>
    <rect x="108" y="228" width="52" height="7" rx="3.5"></rect>
    <rect x="108" y="252" width="80" height="3" rx="1.5" opacity=".35"></rect>
    <rect x="108" y="262" width="66" height="3" rx="1.5" opacity=".35"></rect>
    <rect x="108" y="272" width="74" height="3" rx="1.5" opacity=".35"></rect>
  </g>
  <g transform="rotate(9 260 250)">
    <circle cx="252" cy="212" r="15" fill="#C8F14D"></circle>
    <rect x="232" y="244" width="58" height="4" rx="2" fill="#101110" opacity=".3"></rect>
    <rect x="232" y="256" width="44" height="4" rx="2" fill="#101110" opacity=".3"></rect>
  </g>
</svg>
