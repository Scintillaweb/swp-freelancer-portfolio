---
/** Two mobile app screens side by side. Custom artwork. */
interface Props { label?: string }
const { label = 'Two mobile app screens shown side by side' } = Astro.props;
---

<svg viewBox="0 0 600 450" role="img" aria-label={label}>
  <rect width="600" height="450" fill="#DFE3D6"></rect>
  <g>
    <rect x="146" y="52" width="150" height="330" rx="24" fill="#101110"></rect>
    <rect x="155" y="61" width="132" height="312" rx="17" fill="#fff"></rect>
    <rect x="172" y="92" width="66" height="8" rx="4" fill="#101110" opacity=".7"></rect>
    <rect x="172" y="112" width="98" height="6" rx="3" fill="#101110" opacity=".22"></rect>
    <rect x="172" y="140" width="98" height="72" rx="10" fill="#C8F14D"></rect>
    <rect x="172" y="226" width="98" height="10" rx="5" fill="#101110" opacity=".16"></rect>
    <rect x="172" y="246" width="72" height="10" rx="5" fill="#101110" opacity=".16"></rect>
    <rect x="172" y="312" width="98" height="30" rx="15" fill="#101110"></rect>
  </g>
  <g>
    <rect x="308" y="86" width="150" height="330" rx="24" fill="#101110"></rect>
    <rect x="317" y="95" width="132" height="312" rx="17" fill="#F2F3EF"></rect>
    <circle cx="383" cy="164" r="34" fill="none" stroke="#101110" stroke-width="8" opacity=".85"></circle>
    <path d="M383 130v68" stroke="#C8F14D" stroke-width="8"></path>
    <rect x="334" y="226" width="98" height="10" rx="5" fill="#101110" opacity=".18"></rect>
    <rect x="334" y="248" width="76" height="10" rx="5" fill="#101110" opacity=".18"></rect>
    <rect x="334" y="290" width="98" height="46" rx="12" fill="#fff"></rect>
    <rect x="334" y="348" width="98" height="30" rx="15" fill="#C8F14D"></rect>
  </g>
</svg>
