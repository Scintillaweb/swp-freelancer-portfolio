---
/**
 * Renders one of the built-in inline SVG artworks by key.
 *
 * A project can set `artwork: identity | dashboard | app-screens` in its
 * frontmatter instead of pointing at a photograph. Add your own by
 * dropping a component in `src/components/art/` and registering it here.
 */
import IdentityArt from './IdentityArt.astro';
import DashboardArt from './DashboardArt.astro';
import AppScreensArt from './AppScreensArt.astro';

interface Props {
  name: 'identity' | 'dashboard' | 'app-screens';
  label?: string;
}

const { name, label } = Astro.props;
---

{name === 'identity' && <IdentityArt label={label} />}
{name === 'dashboard' && <DashboardArt label={label} />}
{name === 'app-screens' && <AppScreensArt label={label} />}
