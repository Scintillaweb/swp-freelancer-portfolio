---
/** Tablet mockup against a fluted backdrop. Custom artwork for this theme. */
interface Props { label?: string }
const { label = 'Tablet mockup showing an app screen against a fluted backdrop' } = Astro.props;
const u = Math.random().toString(36).slice(2, 8);
---

<svg viewBox="0 0 400 500" role="img" aria-label={label}>
  <defs>
    <linearGradient id={`flt-${u}`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7A4438"></stop><stop offset="1" stop-color="#4E2A22"></stop></linearGradient>
    <linearGradient id={`scr-${u}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2B3A6B"></stop><stop offset=".5" stop-color="#7A4E9B"></stop><stop offset="1" stop-color="#C86B7A"></stop></linearGradient>
  </defs>
  <rect width="400" height="500" fill={`url(#flt-${u})`}></rect>
  <g opacity=".22" fill="#000">
    <rect x="14" width="10" height="500"></rect><rect x="54" width="10" height="500"></rect><rect x="94" width="10" height="500"></rect>
    <rect x="134" width="10" height="500"></rect><rect x="174" width="10" height="500"></rect><rect x="214" width="10" height="500"></rect>
    <rect x="254" width="10" height="500"></rect><rect x="294" width="10" height="500"></rect><rect x="334" width="10" height="500"></rect><rect x="374" width="10" height="500"></rect>
  </g>
  <rect x="0" y="404" width="400" height="96" fill="#2E1A15" opacity=".55"></rect>
  <g>
    <rect x="66" y="70" width="268" height="352" rx="20" fill="#15171A"></rect>
    <rect x="76" y="80" width="248" height="332" rx="13" fill={`url(#scr-${u})`}></rect>
    <text x="200" y="152" text-anchor="middle" font-family="Space Grotesk, sans-serif" font-size="34" font-weight="700" fill="#fff">9:41</text>
    <rect x="104" y="196" width="192" height="8" rx="4" fill="#fff" opacity=".8"></rect>
    <rect x="104" y="216" width="140" height="8" rx="4" fill="#fff" opacity=".5"></rect>
    <rect x="104" y="256" width="88" height="60" rx="10" fill="#fff" opacity=".18"></rect>
    <rect x="208" y="256" width="88" height="60" rx="10" fill="#C8F14D" opacity=".85"></rect>
    <rect x="104" y="332" width="192" height="42" rx="21" fill="#fff" opacity=".92"></rect>
    <rect x="164" y="349" width="72" height="8" rx="4" fill="#15171A"></rect>
  </g>
  <ellipse cx="200" cy="432" rx="128" ry="16" fill="#000" opacity=".38"></ellipse>
</svg>
