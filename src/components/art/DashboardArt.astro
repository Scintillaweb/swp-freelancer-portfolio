  <circle cx="34" cy="26" r="9" fill="#101110"></circle>
  <rect x="54" y="21" width="76" height="10" rx="5" fill="#101110" opacity=".7"></rect>
  <rect x="470" y="14" width="96" height="24" rx="12" fill="#C8F14D"></rect>
  <rect x="24" y="76" width="248" height="150" rx="14" fill="#fff"></rect>
  <rect x="44" y="98" width="90" height="9" rx="4.5" fill="#101110" opacity=".35"></rect>
