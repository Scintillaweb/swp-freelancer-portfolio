  <rect x="24" y="246" width="552" height="180" rx="14" fill="#fff"></rect>
  <g fill="#101110" opacity=".12">
    <rect x="48" y="278" width="504" height="8" rx="4"></rect><rect x="48" y="308" width="432" height="8" rx="4"></rect>
    <rect x="48" y="338" width="470" height="8" rx="4"></rect><rect x="48" y="368" width="380" height="8" rx="4"></rect>
