---
/**
 * The repeating section header: eyebrow, heading, optional intro, and an
 * optional slot on the right for a button or filter row.
 */
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  /** Heading level. Sections on a page that already has an `<h1>` use `h2`. */
  as?: 'h1' | 'h2';
  /** DOM id for `aria-labelledby`. */
  id?: string;
  class?: string;
}

const { eyebrow, title, intro, as: Tag = 'h2', id, class: className } = Astro.props;
const hasAside = Astro.slots.has('default');
---

<div class:list={['sh', className]}>
  <div class="sh-l">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Tag class="d2" id={id}>{title}</Tag>
    {intro && <p class="lead">{intro}</p>}
  </div>
  {hasAside && <slot />}
</div>
