---
import '~/styles/global.css';
import Seo from '~/components/Seo.astro';
import IconSprite from '~/components/icons/IconSprite.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import BackToTop from '~/components/BackToTop.astro';
import siteConfig from '~/config/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  appendSiteName?: boolean;
  jsonLd?: string;
  /** Extra class on `<body>`, handy for page-specific tweaks. */
  bodyClass?: string;
}

const { bodyClass, ...seo } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="author" content={siteConfig.author} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — Journal`} href="/rss.xml" />

    <!-- Self-hosted fonts: preload only the subsets most visitors need. -->
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Marks the document as scripted before first paint, so progressive
         enhancements (scroll reveal, the nav drawer) never flash. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <Seo {...seo} />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <IconSprite />

    <div class="swp-shell">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <BackToTop />

    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* --- Scroll reveal --------------------------------------------- */
      {
        const els = document.querySelectorAll<HTMLElement>('.rev');
        if (els.length) {
          if (!('IntersectionObserver' in window) || reduce) {
            els.forEach((el) => el.classList.add('in'));
          } else {
            const io = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting) {
                    entry.target.classList.add('in');
                    io.unobserve(entry.target);
                  }
                }
              },
              { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
            );
            els.forEach((el) => io.observe(el));
          }
        }
      }

      /* --- Sticky header state + back to top -------------------------- */
      {
        const hdr = document.querySelector('.hdr');
        const totop = document.getElementById('totop');
        let ticking = false;

        const update = () => {
          const y = window.scrollY;
          hdr?.classList.toggle('stuck', y > 12);
          totop?.classList.toggle('on', y > 700);
          ticking = false;
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          },
          { passive: true }
        );
        update();
      }
    </script>
  </body>
</html>
