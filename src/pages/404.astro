---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." noindex>
  <section class="wrap nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1 class="d2">This page went the way of the fourth rebrand.</h1>
    <p>
      The link is broken, the page moved, or it never existed. The work, the journal and a
      way to get in touch are all still where you left them.
    </p>
    <div class="nf-actions">
      <Button href="/" variant="lime">Back to the homepage</Button>
      <Button href="/work/" variant="outline">See the work</Button>
    </div>
  </section>
</BaseLayout>
