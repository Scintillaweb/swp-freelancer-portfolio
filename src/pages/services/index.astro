---
import PageLayout from '~/layouts/PageLayout.astro';
import ServiceCard from '~/components/cards/ServiceCard.astro';
import Process from '~/components/home/Process.astro';
import Faq from '~/components/home/Faq.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { getCollection } from 'astro:content';
import { isVisible } from '~/lib/utils';
import { graph, breadcrumbSchema, personSchema } from '~/lib/jsonld';

const services = (await getCollection('services'))
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order);

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Services', url: `${siteConfig.url}/services/` },
  ]),
]);
---

<PageLayout
  title="Services"
  heading="Six ways to put me to work."
  eyebrow="Engagements"
  intro="Fixed scope, fixed price, weekly demos. Each of these is a different size of commitment — the one-week review exists precisely so you do not have to start with the six-week one."
  description="Art direction, interface design, design systems, identity, site build and one-week reviews."
  crumbs={[{ label: 'Services' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="svc-list-h">
    <h2 class="sr-only" id="svc-list-h">All services</h2>
    <div class="svc">
      {
        services.map((service, i) => (
          <ServiceCard
            service={service}
            headingLevel="h3"
            class:list={['rev', i % 3 > 0 && `rev-d${i % 3}`]}
          />
        ))
      }
    </div>
  </section>

  <Process />
  <Faq />
  <Cta />
</PageLayout>
