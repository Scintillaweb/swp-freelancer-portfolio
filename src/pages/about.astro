---
import PageLayout from '~/layouts/PageLayout.astro';
import About from '~/components/home/About.astro';
import Toolkit from '~/components/home/Toolkit.astro';
import Process from '~/components/home/Process.astro';
import Awards from '~/components/home/Awards.astro';
import Testimonials from '~/components/home/Testimonials.astro';
import StatsBand from '~/components/home/StatsBand.astro';
import Cta from '~/components/home/Cta.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'About', url: `${siteConfig.url}/about/` },
  ]),
]);
---

<PageLayout
  title="About"
  heading={`Fifteen years, and the same lesson keeps turning up.`}
  eyebrow="About"
  intro={`${siteConfig.author} is an independent art director and interface designer. Fewer clients, harder questions in week one, and a handover that does not quietly depend on one person.`}
  description={`About ${siteConfig.author} — an independent art director and interface designer working with small product teams.`}
  crumbs={[{ label: 'About' }]}
  jsonLd={jsonLd}
>
  <About headingLevel="h2" id="background" />
  <StatsBand />
  <Toolkit />
  <Process />
  <Awards />
  <Testimonials />
  <Cta />
</PageLayout>
